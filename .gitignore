# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# SAUF le modele : il nomme chaque clef et dit ce qu on perd sans elle, donc il
# doit arriver avec le clone. Mesure du 22 octobre 2026 : il etait avale par la
# ligne ci-dessus, et un poste neuf n avait aucune liste des clefs a poser.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local
.dev.log

# fichiers sources déposés en mode démo
.uploads/

# Maquettes de travail, servies par le serveur de développement pour que
# leurs scripts tournent ; elles ne font pas partie du produit.
public/maquette/

# Les sorties de mesure : elles se refont, elles ne se versionnent pas.
.mesure/
.tmp-*
cours-a-verifier.xlsx
