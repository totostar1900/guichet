# Copier en .env.local et remplir. Sans ces variables, l'app tourne sur les données de démonstration en mémoire.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Côté serveur uniquement (jamais exposé au navigateur) — utilisé par le desk tant que l'auth n'est pas en place.
SUPABASE_SERVICE_ROLE_KEY=

# Authentification
# Adresses e-mail du desk (amorçage) — séparées par des virgules. Sinon : update profiles set role='desk' …
DESK_EMAILS=
# Secret de signature de la session de démonstration (mode sans Supabase). Changer en production.
AUTH_SECRET=

# Extraction automatique des communiqués (desk › À valider). Sans clé : saisie manuelle.
ANTHROPIC_API_KEY=
# Variante acceptée partout où ANTHROPIC_API_KEY l'est : l'une OU l'autre suffit.
ANTHROPIC_AUTH_TOKEN=
# Modèle de lecture. Défaut dans le code : claude-opus-5. INTAKE_READ_MODEL ne vaut
# que pour la boîte d'entrée et passe devant AUCTION_READ_MODEL ; ce dernier vaut
# pour les adjudications, les états financiers et le reste de la lecture de pièces.
AUCTION_READ_MODEL=
INTAKE_READ_MODEL=

# Instructions de règlement : le DÉFAUT seulement. Depuis le 25 octobre 2026, le
# desk les écrit dans l'application (Référentiel › Compte de règlement), ce qui
# passe par-dessus ces trois variables. Elles restent lues pour qu'un
# déploiement qui les porte déjà ne perde rien ; une maison nouvelle n'a pas à
# les remplir. Le BIC ne sert qu'aux virements venus de l'étranger.
SETTLEMENT_BANK=
SETTLEMENT_IBAN=
SETTLEMENT_BIC=

# Diffusion — WhatsApp Cloud API (Meta). Sans ces variables, les messages sont journalisés « préparés », jamais envoyés.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
# Noms des modèles approuvés (corps à 4 paramètres pour l'offre : titre, accroche, clôture, lien ; 2 pour la mise à jour : nom, texte)
WA_TEMPLATE_OFFER=guichet_offre
WA_TEMPLATE_UPDATE=guichet_maj
WA_TEMPLATE_PRELEVEMENT=guichet_prelevement
# WA_FREEFORM=1 envoie du texte libre au lieu des modèles (tests, fenêtre de 24 h)
WA_FREEFORM=
# WHATSAPP_DEMO=1 autorise la preuve de démonstration. Déjà vraie hors production.
WHATSAPP_DEMO=
# Diffusion — e-mail (Resend)
RESEND_API_KEY=
# NOTIFY_DEMO=1 marque « envoyé » sans rien envoyer, quand aucun canal n'est configuré.
NOTIFY_DEMO=
EMAIL_FROM="Purpose Capital <guichet@purposecapital.africa>"
# URL publique de l'application (liens dans les messages)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Le desk sur son propre hôte (ex. desk.purposecapital.africa) : /desk n'existe que là, le site client ne montre aucun bouton desk. Vide = un seul hôte (dev).
NEXT_PUBLIC_DESK_HOST=

# Tâche planifiée des avis de coupon (/api/cron/coupons) — jeton attendu en Authorization: Bearer
CRON_SECRET=

# Robot WhatsApp (répond aux messages entrants avec Claude, BOT_ENABLED=0 pour couper)
BOT_ENABLED=1

# Connexion par téléphone (Supabase Auth › Phone, fournisseur SMS/WhatsApp configuré côté Supabase)
PHONE_OTP_ENABLED=0
PHONE_OTP_CHANNEL=sms   # ou whatsapp (Twilio)

# Connexion par Google (Supabase › Authentication › Providers › Google, avec l'ID
# et le secret OAuth pris chez Google Cloud ; l'URI de redirection autorisée y est
# https://<projet>.supabase.co/auth/v1/callback). Le bouton ne paraît que si ceci vaut 1.
GOOGLE_OAUTH_ENABLED=0

# Pré-contrôle sanctions / PPE automatique (facultatif) — https://www.opensanctions.org/api/
OPENSANCTIONS_API_KEY=

# Desk : second facteur (TOTP) obligatoire ; DESK_MFA=off le désactive (amorçage, incident) — jamais en production durable.
DESK_MFA=

# Boîte d'entrée : POST /api/inbound/email (Authorization: Bearer INBOUND_SECRET) reçoit les courriels et pièces jointes.
INBOUND_SECRET=
# Expéditeurs de confiance (domaines, adresses ou numéros E.164, séparés par des virgules) : leurs sources arrivent « officielles ».
INTAKE_TRUSTED_SENDERS=tresor-congo.cg,dgtcfm.cm
# Webhook Resend : le secret signe les appels, la clé de lecture télécharge la pièce
# brute. Sans RESEND_INBOUND_API_KEY, RESEND_API_KEY sert. Sans secret, rien n'entre.
RESEND_WEBHOOK_SECRET=
RESEND_INBOUND_API_KEY=

# Veille : adresses de flux séparées par des virgules, en plus de celles du référentiel.
NEWS_FEEDS=

# Notifications push (web push, gratuit) : générer avec `npx web-push generate-vapid-keys`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:info@purposecapital.africa

# LE DOSSIER SYNCHRONISE DE LA BIBLIOTHEQUE PARTAGEE, sur une machine de la
# maison. Vide en production, et c'est voulu : Vercel n'a pas de disque, et le
# desk y renvoie par un lien.
#
# Il sert au REPLI de readSource : depuis le 14 octobre 2026, les bulletins ne
# sont plus au depot, et c'est ce repli qui garde la relecture possible. Les
# 53 scripts de reprise tournent ici, et 763 lignes d'encours ont ete
# retrouvees ce jour-la par une relecture.
BIBLIOTHEQUE_DISQUE=
# L'ADRESSE WEB de cette même bibliothèque, celle vers laquelle le desk renvoie.
# Défaut dans le code : le site SharePoint de la maison. À poser seulement s'il change.
BIBLIOTHEQUE_WEB=

# DEUX INTERRUPTEURS D'ESSAI, jamais posés en production.
# GUICHET_ESSAI=1 met l'app en mode essai (déjà vrai sur la branche « essai »).
# GUICHET_SEMIS=reference charge le semis dense du référentiel au lieu du minimum.
GUICHET_ESSAI=
GUICHET_SEMIS=
